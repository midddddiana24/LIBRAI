{
  "name": "librai-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "types:generate": "openapi-typescript ../docs/openapi.json -o src/openapi.d.ts",
    "android:sync": "node scripts/check-android-env.mjs && npm run build && cap sync android",
    "android:open": "cap open android",
    "test:ui-smoke": "node scripts/ui-smoke.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/barcode-scanner": "^3.1.3",
    "@capacitor/core": "^8.5.3",
    "lucide-react": "^1.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.64.0",
    "typescript": "~5.9",
    "vite": "^8.3.0"
  }
}
