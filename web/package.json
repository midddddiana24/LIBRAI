{
  "name": "librai-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-ocr-assets.mjs",
    "prebuild": "node scripts/prepare-ocr-assets.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "types:generate": "openapi-typescript ../docs/openapi.json -o src/openapi.d.ts",
    "android:sync": "node scripts/check-android-env.mjs && npm run build && cap sync android",
    "android:open": "cap open android",
    "test:ui-smoke": "node scripts/ui-smoke.mjs",
    "test:voice": "node --test src/voiceCommands.test.mjs src/audioActivity.test.mjs",
    "test:voice-ui": "node scripts/voice-ui-smoke.mjs",
    "test:design-ui": "node scripts/design-ui-smoke.mjs",
    "test:borrow-ui": "node scripts/borrow-ui-smoke.mjs",
    "test:id-fields": "node --test src/idCardFields.test.mjs",
    "test:registration-ui": "node scripts/registration-ui-smoke.mjs",
    "test:ai-ui": "node scripts/ai-ui-smoke.mjs",
    "test:startup-ui": "node scripts/startup-ui-smoke.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/barcode-scanner": "^3.1.3",
    "@capacitor/core": "^8.5.3",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.64.0",
    "typescript": "~5.9",
    "vite": "^8.3.0"
  }
}
